{
  "manifest_version": 3,
  "name": "CRAS Browser Tracker",
  "version": "1.0",
  "description": "Reports active tab and open tabs to local CRAS agent",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CRAS Tracker"
  }
}